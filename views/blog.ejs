<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>The Blog | Blogs</title>
    <link rel="stylesheet" href="/stylesheets/header.css">
    <link rel="stylesheet" href="/stylesheets/footer.css">
    <link rel="stylesheet" href="/stylesheets/blog.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Sen:wght@400..800&display=swap"
          rel="stylesheet">
    <link rel="shortcut icon" href="/images/favicon.svg" type="image/x-icon">
</head>
<body>
<%- include('partials/header', {email: email}); %>

<div class="container blog-details-wrapper">
    <div class="recent-blogs-wrapper">
        <h2 class="title">Recent blog posts</h2>
        <% recentBlogs.forEach((blog) => { %>
            <div>
                <figure>
                    <img src="<%= blog.thumbnail || '/images/thumbnails/thumbnail-6.png' %>" alt="<%= blog.title %>">
                </figure>
                <div>
                    <p class="meta"><%= blog.author.email %>
                        • <%= blog.date.getDate() %> <%= blog.date.toLocaleString('default', {month: 'short'}) %> <%= blog.date.getFullYear() %>
                    </p>
                    <figure class="blog-title-wrapper">
                        <a href="/blogs/<%= blog._id %>"><%= blog.title %></a>
                        <img src="/images/arrow-up-icon.svg" alt="Arrow up icon">
                    </figure>
                    <p class="description"><%= blog.description %></p>
                </div>
            </div>
        <% }) %>
    </div>
    <div class="blog-content">
        <p class="meta">
            <%= blog.author.email %>
            • <%= blog.date.getDate() %> <%= blog.date.toLocaleString('default', {month: 'short'}) %> <%= blog.date.getFullYear() %>
        </p>
        <% const isBookmarked = bookmarkedIds.includes(blog._id.toString()); %>
        <% const isOwner = currentUserId && blog.author && blog.author._id && currentUserId === blog.author._id.toString(); %>
        <div class="blog-content-title-wrapper">
            <h2 class="blog-content-title">
                <%= blog.title %>
            </h2>
            <div class="blog-detail-actions">
                <form class="bookmark-form" action="/blogs/<%= blog._id %>/bookmark" method="POST">
                    <input type="hidden" name="returnUrl" value="/blogs/<%= blog._id %>">
                    <button type="submit" class="bookmark-btn <%= isBookmarked ? 'bookmarked' : '' %>"
                            aria-label="<%= isBookmarked ? 'Remove bookmark' : 'Bookmark this blog' %>">
                        <svg class="bookmark-icon" width="18" height="18" viewBox="0 0 24 24"
                             fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M6 4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v17l-6-3.5L6 21V4Z"
                                  stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                        </svg>
                        <span class="bookmark-label"><%= isBookmarked ? 'Saved' : 'Save' %></span>
                    </button>
                </form>
                <% if (isOwner) { %>
                    <form class="blog-delete-form" action="/blogs/<%= blog._id %>/delete" method="POST">
                        <button type="submit" class="blog-delete-btn">Delete</button>
                    </form>
                <% } %>
            </div>
        </div>
        <div>
            <p class="blog-content-text">
                <%= blog.content %>
            </p>
        </div>

        <div class="newsletter-widget-wrapper">
            <p class="newsletter-widget-subtitle">
                Newsletter
            </p>

            <h2 class="newsletter-widget-title">
                Stories and interviews
            </h2>

            <p class="newsletter-widget-description">
                Subscribe to learn about new product features, the latest in technology, solutions, and updates.
            </p>

            <form class="newsletter-widget-form-wrapper" action="/newsletters/subscribe" method="POST">
                <div class="newsletter-widget-input-wrapper">
                    <input type="hidden" name="returnUrl" value="/blogs/<%= blog._id %>">
                    <input name="subscribeEmail" class="newsletter-widget-input" type="text"
                           placeholder="Enter your email">
                    <p class="newsletter-widget-input-label">
                        We care about your data in our <a href="/">privacy policy</a>
                    </p>
                </div>
                <button type="submit" class="newsletter-widget-subscribe-btn">Subscribe</button>
            </form>
        </div>

        <%
            const formatDate = (d) => `${d.toLocaleString('default', {month: 'short'})} ${d.getDate()}, ${d.getFullYear()}`;
            const displayName = (mail) => (mail || 'user').split('@')[0];
            const initial = (mail) => (mail || 'u').charAt(0).toUpperCase();
            const idOf = (ref) => (ref && ref._id ? ref._id.toString() : (ref ? ref.toString() : null));
            const blogAuthorId = idOf(blog.author);
            const isBlogAuthor = currentUserId && currentUserId === blogAuthorId;
        %>

        <section class="comments-wrapper">
            <h2 class="comments-title">
                Comments <span class="comments-count">(<%= blog.comments.length %>)</span>
            </h2>

            <form class="comment-form" action="/blogs/<%= blog._id %>/comments" method="POST">
                <textarea name="content" class="comment-input" rows="3"
                          placeholder="Add a comment..." required></textarea>
                <button type="submit" class="comment-post-btn">Post Comment</button>
            </form>

            <div class="comments-list">
                <% if (blog.comments.length === 0) { %>
                    <p class="comments-empty">No comments yet. Be the first to share your thoughts!</p>
                <% } %>

                <% blog.comments.slice().reverse().forEach((comment) => { %>
                    <% const liked = comment.likes.some((id) => id.toString() === currentUserId); %>
                    <% const canDeleteComment = currentUserId && (currentUserId === idOf(comment.author) || isBlogAuthor); %>
                    <% const canEditComment = currentUserId && currentUserId === idOf(comment.author); %>
                    <article class="comment">
                        <div class="comment-avatar"><%= initial(comment.author && comment.author.email) %></div>
                        <div class="comment-body">
                            <div class="comment-header">
                                <div>
                                    <p class="comment-author"><%= displayName(comment.author && comment.author.email) %></p>
                                    <p class="comment-date">
                                        <%= formatDate(comment.date) %>
                                        <% if (comment.editedAt) { %>
                                            <span class="comment-edited">· edited on <%= formatDate(comment.editedAt) %></span>
                                        <% } %>
                                    </p>
                                </div>
                                <form class="comment-like-form"
                                      action="/blogs/<%= blog._id %>/comments/<%= comment._id %>/like" method="POST">
                                    <button type="submit" class="comment-like-btn <%= liked ? 'liked' : '' %>"
                                            aria-label="Like comment">
                                        <svg class="like-icon" width="16" height="16" viewBox="0 0 24 24"
                                             fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M7 10v11M2 13v6a2 2 0 0 0 2 2h13.5a2 2 0 0 0 2-1.7l1.3-8A2 2 0 0 0 18.8 9H14l.7-4.2a2 2 0 0 0-2-2.3 1.5 1.5 0 0 0-1.3.8L7 10"
                                                  stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                  stroke-linejoin="round"/>
                                        </svg>
                                        <span class="comment-like-count"><%= comment.likes.length %></span>
                                    </button>
                                </form>
                            </div>

                            <div class="comment-text">
                                <p class="comment-content"><%= comment.content %></p>
                                <% if (canEditComment) { %>
                                    <form class="comment-edit-form" id="edit-form-<%= comment._id %>"
                                          action="/blogs/<%= blog._id %>/comments/<%= comment._id %>/edit" method="POST">
                                        <textarea name="content" class="comment-input" rows="3" required><%= comment.content %></textarea>
                                        <button type="submit" class="comment-reply-submit">Save</button>
                                    </form>
                                <% } %>
                            </div>

                            <div class="comment-actions">
                                <button type="button" class="comment-reply-toggle"
                                        data-target="reply-form-<%= comment._id %>">Reply</button>
                                <% if (canEditComment) { %>
                                    <button type="button" class="comment-edit-toggle"
                                            data-edit-target="edit-form-<%= comment._id %>">Edit</button>
                                <% } %>
                                <% if (canDeleteComment) { %>
                                    <form class="comment-delete-form"
                                          action="/blogs/<%= blog._id %>/comments/<%= comment._id %>/delete" method="POST">
                                        <button type="submit" class="comment-delete-btn">Delete</button>
                                    </form>
                                <% } %>
                            </div>

                            <form class="comment-reply-form" id="reply-form-<%= comment._id %>"
                                  action="/blogs/<%= blog._id %>/comments/<%= comment._id %>/replies" method="POST">
                                <textarea name="content" class="comment-input" rows="2"
                                          placeholder="Write a reply..." required></textarea>
                                <button type="submit" class="comment-reply-submit">Reply</button>
                            </form>

                            <% if (comment.replies && comment.replies.length > 0) { %>
                                <div class="comment-replies">
                                    <% comment.replies.forEach((reply) => { %>
                                        <% const replyLiked = reply.likes.some((id) => id.toString() === currentUserId); %>
                                        <% const canDeleteReply = currentUserId && (currentUserId === idOf(reply.author) || isBlogAuthor); %>
                                        <% const canEditReply = currentUserId && currentUserId === idOf(reply.author); %>
                                        <article class="comment comment--reply">
                                            <div class="comment-avatar comment-avatar--small">
                                                <%= initial(reply.author && reply.author.email) %>
                                            </div>
                                            <div class="comment-body">
                                                <div class="comment-header">
                                                    <div>
                                                        <p class="comment-author"><%= displayName(reply.author && reply.author.email) %></p>
                                                        <p class="comment-date">
                                                            <%= formatDate(reply.date) %>
                                                            <% if (reply.editedAt) { %>
                                                                <span class="comment-edited">· edited on <%= formatDate(reply.editedAt) %></span>
                                                            <% } %>
                                                        </p>
                                                    </div>
                                                    <form class="comment-like-form"
                                                          action="/blogs/<%= blog._id %>/comments/<%= comment._id %>/replies/<%= reply._id %>/like" method="POST">
                                                        <button type="submit" class="comment-like-btn <%= replyLiked ? 'liked' : '' %>"
                                                                aria-label="Like reply">
                                                            <svg class="like-icon" width="16" height="16" viewBox="0 0 24 24"
                                                                 fill="none" xmlns="http://www.w3.org/2000/svg">
                                                                <path d="M7 10v11M2 13v6a2 2 0 0 0 2 2h13.5a2 2 0 0 0 2-1.7l1.3-8A2 2 0 0 0 18.8 9H14l.7-4.2a2 2 0 0 0-2-2.3 1.5 1.5 0 0 0-1.3.8L7 10"
                                                                      stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                                      stroke-linejoin="round"/>
                                                            </svg>
                                                            <span class="comment-like-count"><%= reply.likes.length %></span>
                                                        </button>
                                                    </form>
                                                </div>
                                                <div class="comment-text">
                                                    <p class="comment-content"><%= reply.content %></p>
                                                    <% if (canEditReply) { %>
                                                        <form class="comment-edit-form" id="edit-form-<%= reply._id %>"
                                                              action="/blogs/<%= blog._id %>/comments/<%= comment._id %>/replies/<%= reply._id %>/edit" method="POST">
                                                            <textarea name="content" class="comment-input" rows="2" required><%= reply.content %></textarea>
                                                            <button type="submit" class="comment-reply-submit">Save</button>
                                                        </form>
                                                    <% } %>
                                                </div>
                                                <% if (canEditReply || canDeleteReply) { %>
                                                    <div class="comment-actions">
                                                        <% if (canEditReply) { %>
                                                            <button type="button" class="comment-edit-toggle"
                                                                    data-edit-target="edit-form-<%= reply._id %>">Edit</button>
                                                        <% } %>
                                                        <% if (canDeleteReply) { %>
                                                            <form class="comment-delete-form"
                                                                  action="/blogs/<%= blog._id %>/comments/<%= comment._id %>/replies/<%= reply._id %>/delete" method="POST">
                                                                <button type="submit" class="comment-delete-btn">Delete</button>
                                                            </form>
                                                        <% } %>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </article>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    </article>
                <% }) %>
            </div>
        </section>
    </div>
</div>

<script src="/javascripts/blog-delete.js"></script>
<script src="/javascripts/comments.js"></script>

<%- include('partials/footer'); %>

</body>
</html>